# Copy to .env for local development (never commit .env). All values are optional.
# Every setting is prefixed VIRELLO_.

# development | test | production. Production turns off the interactive docs and sends HSTS.
VIRELLO_ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
VIRELLO_LOG_LEVEL=INFO

# Origins allowed to call the API from a browser, comma separated. Explicit origins only: "*" is
# rejected at startup.
VIRELLO_CORS_ORIGINS=http://localhost:3000

# Force the interactive docs on or off. Unset means: on except in production.
# VIRELLO_DOCS_ENABLED=true

# SEC EDGAR requires every client to identify itself with a contact. Needed for the company routes; required in production.
# Keep your real address here, in the untracked .env or the host's secret store; never commit it.
# VIRELLO_SEC_CONTACT_EMAIL=you@example.com

# Postgres, async driver only. Unset means no database: the app still starts, and anything that
# needs it answers 503. Never commit the real value.
# VIRELLO_DATABASE_URL=postgresql+asyncpg://virello_app:change-me@localhost:5432/virello

# Used only by the tests; the database name must end in _test. Without it the database tests skip
# locally (and fail in CI).
# VIRELLO_TEST_DATABASE_URL=postgresql+asyncpg://virello_app:change-me@localhost:5432/virello_test

# Pool and timeouts (defaults shown). The pool is bounded so a burst queues, then fails fast.
# VIRELLO_DB_POOL_SIZE=5
# VIRELLO_DB_MAX_OVERFLOW=5
# VIRELLO_DB_POOL_TIMEOUT_SECONDS=5
# VIRELLO_DB_STATEMENT_TIMEOUT_MS=5000
# VIRELLO_DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000
