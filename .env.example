# Used by docker-compose.yml. Copy to .env (which is git-ignored) and fill in.
# Do not reuse a password from anywhere else; this database only listens on localhost.
POSTGRES_PASSWORD=
# Host port for the container's Postgres. 5433 avoids a clash with a locally installed Postgres.
# POSTGRES_PORT=5433

# Then point the backend at it in backend/.env. Use 127.0.0.1, not localhost: the container only
# listens on IPv4, and "localhost" tries IPv6 first, which makes every new connection slow.
#   VIRELLO_DATABASE_URL=postgresql+asyncpg://virello_app:<password>@127.0.0.1:5433/virello
#   VIRELLO_TEST_DATABASE_URL=postgresql+asyncpg://virello_app:<password>@127.0.0.1:5433/virello_test
