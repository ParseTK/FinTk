{
  "name": "fintk-frontend",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "new:component": "node scripts/new-component.mjs",
    "gen:api": "openapi-typescript ../backend/openapi.json -o src/lib/api/schema.d.ts",
    "test:coverage": "vitest run --coverage",
    "license:check": "npx --yes license-checker-rseidelsohn@4.4.2 --summary --production --excludePrivatePackages --excludePackagesStartingWith \"@img/sharp\" --onlyAllow \"MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;CC-BY-4.0;CC0-1.0;BlueOak-1.0.0;Unlicense\"",
    "budget": "node scripts/check-budgets.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "^16.4.5",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
