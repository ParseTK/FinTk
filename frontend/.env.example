# Where the FastAPI service lives. Server-side only: the browser never calls it directly.
API_URL=http://localhost:8000
# Shared secret sent to the API so it knows the call comes from this server (needed for routes that
# return a data vendor's content). Server-side only: never give it a NEXT_PUBLIC_ prefix. Must match
# VIRELLO_INTERNAL_API_TOKEN on the API. Generate with: openssl rand -base64 48
# INTERNAL_API_TOKEN=

# Feature flags, read at request time. Values: true/false (also 1/0, on/off, yes/no).
# New features default to off; shipped features default to on and can be switched off as a kill
# switch (a simpler fallback is shown). See src/lib/flags.ts for what each one does.
# FEATURE_AUTH=false
# FEATURE_CRYPTO=false
# Depends on: FEATURE_CRYPTO
# FEATURE_CRYPTO_MARKETS=false
# Depends on: FEATURE_CRYPTO
# FEATURE_CRYPTO_NEWS=false
# FEATURE_PALETTE=true
# FEATURE_DESIGN=false
# FEATURE_SCROLL_MOTION=true
