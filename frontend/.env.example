# Where the FastAPI service lives. Server-side only: the browser never calls it directly.
API_URL=http://localhost:8000

# Feature flags, read at request time. Values: true/false (also 1/0, on/off, yes/no).
# New features default to off; shipped features default to on and can be switched off as a kill
# switch (a simpler fallback is shown). See src/lib/flags.ts for what each one does.
# FEATURE_AUTH=false
# FEATURE_SEASONALITY=false
# FEATURE_VALUATION=false
# FEATURE_PORTFOLIO_V2=false
# FEATURE_MARKETS=false
# FEATURE_NEWS=false
# FEATURE_HERO_CHART=true
# FEATURE_RICH_SEARCH=true
# FEATURE_PALETTE=true
# FEATURE_MARKET_TICKER=true
# FEATURE_DESIGN=false
# FEATURE_SCROLL_MOTION=true
